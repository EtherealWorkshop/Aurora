source /usr/share/aurora/functions
umask 022
for script in /etc/profile.d/*.sh ; do
  if [ -r "$script" ] ; then
    . "$script"
  fi
done
unset script

if [ "$USER" = "root" ]; then
  PS1='\e[1;31m\u@\h \e[1;33m$(date +"%H:%M %b %d")\e[1;32m \w/\e[0m '
else
  PS1='\e[1;34m\u@\h \e[1;33m$(date +"%H:%M %b %d")\e[1;32m \w/\e[0m '
fi

if [ -z "$login" ]; then
  term_login
  stty intr '^C'
  export XDG_RUNTIME_DIR=/run/user/$(id -u $username)
  mkdir -p $XDG_RUNTIME_DIR
  exec sudo -u "$username" login=1 XDG_RUNTIME_DIR=$XDG_RUNTIME_DIR bash -l
fi