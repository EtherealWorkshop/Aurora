get_largest_cros_blockdev() {
	local largest size dev_name tmp_size remo
	size=0
	for blockdev in /sys/block/*; do
		dev_name="${blockdev##*/}"
		echo -e "$dev_name" | grep -q '^\(loop\|ram\)' && continue
		tmp_size=$(cat "$blockdev"/size)
		remo=$(cat "$blockdev"/removable)
		if [ "$tmp_size" -gt "$size" ] && [ "${remo:-0}" -eq 0 ]; then
			case "$(sfdisk -d "/dev/$dev_name" 2>/dev/null)" in
				*'name="STATE"'*'name="KERN-A"'*'name="ROOT-A"'*)
					largest="/dev/$dev_name"
					size="$tmp_size"
					;;
			esac
		fi
	done
	echo -e "$largest"
}

get_partitions() {
    export cros_drive="$(get_largest_cros_blockdev)"
    export cros_stateful=$(cgpt find -l STATE ${cros_drive} 2>/dev/null | head -n 1 | grep --color=never /dev/)
    export cros_kern_a=$(cgpt find -l KERN-A ${cros_drive} 2>/dev/null | head -n 1 | grep --color=never /dev/)
    export cros_root_a=$(cgpt find -l ROOT-A ${cros_drive} 2>/dev/null | head -n 1 | grep --color=never /dev/)
    export cros_kern_b=$(cgpt find -l KERN-B ${cros_drive} 2>/dev/null | head -n 1 | grep --color=never /dev/)
    export cros_root_b=$(cgpt find -l ROOT-B ${cros_drive} 2>/dev/null | head -n 1 | grep --color=never /dev/)
}
