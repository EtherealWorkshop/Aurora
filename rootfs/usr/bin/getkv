#!/bin/bash

mount --bind /.crosenv /.crosenv
for mnt in /dev /proc /sys; do
    mkdir -p /.crosenv$mnt
    mount --bind "$mnt" "/.crosenv$mnt"
done
cmd_output=$(chroot /.crosenv tpmc read 0x1008 9 2>/dev/null)
chmod +x /usr/bin/raw2hex
raw2hex $cmd_output
for mnt in /dev /proc /sys; do
    umount "/.crosenv$mnt" 2>/dev/null
done
umount /.crosenv 2>/dev/null