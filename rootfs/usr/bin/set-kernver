#!/bin/bash

source /usr/share/aurora/functions
chmod +x /usr/bin/hex2raw
export TERM=xterm-256color

set-kernver() {
    while true; do
        read_center -d "Enter Kernver[Max 8 characters after 0x]: 0x" kernver
        mount --bind /.crosenv /.crosenv
        for mnt in /dev /proc /sys; do
            mkdir -p /.crosenv$mnt
            mount --bind "$mnt" "/.crosenv$mnt"
        done
        vercheck=$(chroot /.crosenv tpmc read 0x1008 1 | tr -d '\r\n[:space:]')
        if [[ "$vercheck" == *2 ]]; then
            ver=0
        elif [ "$vercheck" = "10" ]; then
            ver=1
        fi
        if [ ! -n "$ver" ]; then
            echo "$vercheck"
            break
        fi
        break=1
        if [[ ! "$kernver" =~ ^[0-9A-Fa-f]{1,8}$ ]]; then
            echo "Invalid Kernver. Maximum 8 characters after 0x [e.g: 0x00000001]" | center
            break=0
            for mnt in /dev /proc /sys; do
                umount "/.crosenv$mnt"
            done
            continue
        fi
        rawbytes=$(hex2raw "0x${kernver}" --ver="$ver")
        if [ "$(echo $rawbytes | awk '{print $1}')" == "$vercheck" ]; then
            mkdir -p /root/.cache/logs/kernver/
            echo "0x$kernver  >  $rawbytes" >/root/.cache/logs/kernver/log-$kernver
            echo_c "Successfuly converted kernver 0x$kernver to raw bytes." BLUE_B | center
        else
            fail "Failed to convert kernver to raw bytes"
        fi
        chroot /.crosenv bash -c "tpmc write 0x1008 $rawbytes" >/dev/null || {
            echo "Invalid Kernver. Maximum 8 characters after 0x [e.g: 0x00000001]" | center
            break=0
            for mnt in /dev /proc /sys; do
                umount "/.crosenv$mnt"
            done
            continue
        }
        for mnt in /dev /proc /sys; do
            umount "/.crosenv$mnt"
        done
        kernver=$(printf "%08s" "$kernver" | tr ' ' '0')
        echo "0x$kernver" > /etc/kernverpending
        if [ "$break" = "1" ]; then break; fi
    done
    umount /.crosenv
    sync
}

if [ "$(crossystem mainfw_type)" = "recovery" ]; then
    set-kernver
else
    echo "Please boot Aurora in recovery [Esc+Ref+Pwr] to set your Kernver" | center
    read_center "Press Enter to return to the main menu"
fi
