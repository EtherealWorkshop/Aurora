#!/bin/bash
tput civis
stty -echo
printf "\033]input:on\a"
printf "\033[?25h"
/bin/busybox --install -s /bin
rm -f /init
clear
export TTY1="/dev/tty1"
export TTY2="/dev/tty2"
export TTY3="/dev/tty4"
[ -e /dev/pts/0 ] && export TTY1="/dev/pts/0" && export TTY2="/dev/pts/1" && export TTY3="/dev/pts/3"
startfrecon() {
    export TERM=xterm-256color
    mkdir -p /.crosenv/tmp /.crosenv/run/frecon /run/frecon /.crosenv/run/frecon.keep
    mount --bind /run/frecon /.crosenv/run/frecon || true
    mount --bind /.crosenv /.crosenv
    for mnt in /dev /proc /sys; do
        mount --move $mnt /.crosenv$mnt
    done
    mount -t devpts devpts /.crosenv/dev/pts
    pivot_root /.crosenv /.crosenv/tmp
    export PATH="/bin:/sbin:/usr/bin:/usr/sbin"
    busybox pkill -9 frecon || :
    busybox rm -rf /run/frecon
    frecon-lite --enable-vt1 --daemon --no-login --enable-vts --pre-create-vts --num-vts=8 --enable-gfx
    until [ -e /run/frecon/vt0 ]; do busybox sleep 0.1; done
    exec </run/frecon/vt0 >/run/frecon/vt0 2>&1
    busybox printf "\033]input:on\a\033]switchvt:0\a"
    busybox mount --bind /tmp /tmp
    for mnt in /dev /proc /sys; do
        busybox mount --move $mnt /tmp$mnt
    done
    busybox mount --bind /run/frecon /run/frecon.keep
    pivot_root /tmp /tmp/tmp
    export PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
    mount --move /tmp/run/frecon.keep /run/frecon
}
startfrecon
setsid -c test
exec bash /usr/share/aurora/aurora.sh