COLOR_RESET="\033[0m"
RED_B="\033[1;31m"
GEEN_B="\033[1;32m"
YELLOW_B="\033[1;33m"
BLUE_B="\033[1;34m"
MAGENTA_B="\033[1;35m"
PINK_B="\x1b[1;38;2;235;170;238m"
CYAN_B="\033[1;36m"

cleanup() {
  umount $auroraboot/etc/resolv.conf -l 2>/dev/null
  umount $rootfs/etc/resolv.conf -l 2>/dev/null
  for dir in proc sys dev run; do umount -l "$rootfs/$dir"; done
  umount $rootfs $auroraboot $statemount $root_amount $root_bmount
  rm -rf "$rootfs" "$auroraboot" "$statemount" "$root_amount" "$root_bmount"
  losetup -D $dev
  exit 1
}

lsbval() {
  local key="$1" lsbfile="${2:-$rootfs/etc/lsb-release}"
  echo "$key" | grep -Eq '^[a-zA-Z0-9_]+$' || return 1
  sed -E -n -e "/^[[:space:]]*${key}[[:space:]]*=/{
    s:^[^=]+=[[:space:]]*::
    s:[[:space:]]+$::
    p
  }" "$lsbfile"
}

. checks $@

verbose="${verbose:=false}"
krill="${krill:=false}"
$verbose && set -x

auroraboot=$(mktemp -d)
rootfs=$(mktemp -d)
rm -rf "$rootfs" "$auroraboot"
mkdir -p "$rootfs" "$auroraboot"

[ -z "rootfs/usr/share/aurora/aurora.sh" ] && echo_c "Please run in the base directory of Aurora." RED_B
if findmnt -T "$rootfs" -o OPTIONS -n | grep -qE 'noexec|nodev'; then
    mount -o remount,dev,exec "$(findmnt -T "$rootfs" -o TARGET -n)"
fi
rm -f "$aurorashim"
kb=204800K
if [ -z "$shims" ] && [ -z "$recovery" ] && [ -z "$shimsize" ]; then # haha 69
  echo_c "Creating shim with size $kb" GEEN_B
  truncate -s $kb "$aurorashim"
elif [ -n "$shims" ] || [ -n "$recovery" ] && [ $(df --output=avail / | tail -1) -gt $((15*1024*1024)) ]; then
  shimsize=204800
  recovery=${recovery:=""}
  shims=${shims:=""}
  for image in $shims $recovery; do
    [ -e "$image" ] || {
      echo_c "$image not found. Skipping..." RED_B
      continue
    }
    image_kilobytes=$(du -sk $image | awk '{print $1}')
    shimsize=$((shimsize+image_kilobytes+4096))
  done
  echo_c "Building Aurora with size $(echo "scale=1; $shimsize/1024/1024" | bc)GB" GEEN_B
  debug_msg "[${shimsize}KB]" RED_B
  echo_c "Recovery Images: ${recovery:="None"}" GEEN_B
  echo_c "Shims: ${shims:="None"}" GEEN_B
  echo_c "Extra payloads: ${payloads:="None"}" GEEN_B
  truncate -s ${shimsize}K "$aurorashim"
elif [ -n "$shimsize" ] && [ "$shimsize" -gt "204800" ] && [ $(df --output=avail / | tail -1) -gt $shimsize ]; then
  echo_c "Creating shim with size $(echo "scale=1; $shimsize/1024/1024" | bc)GB" GEEN_B
  truncate -s ${shimsize}K "$aurorashim"
else
  echo_c "Not enough free space on disk. Available:$(df -h --output=avail / | tail -1)" RED_B
  exit 1
fi

echo_c "\nBootstrapping Alpine" BLUE_B
[ ! -f alpine-minirootfs.tar.gz ] && wget -q --show-progress "https://dl-cdn.alpinelinux.org/alpine/v3.22/releases/$arch/alpine-minirootfs-3.22.0-$arch.tar.gz" -O alpine-minirootfs.tar.gz 

tar -xf alpine-minirootfs.tar.gz -C "$rootfs"
rm -f "$rootfs/sbin/init"


if [ "$hostarch" != "$arch" ]; then
    echo_c "Done. Rootfs: $(du -sh $rootfs | awk '{print $1}')\n\n${BLUE_B}Setting up QEMU " GEEN_B
    sudo mount -t binfmt_misc none /proc/sys/fs/binfmt_misc 2>/dev/null
    if ! grep -q binfmt_misc /proc/filesystems; then
       sudo modprobe binfmt_misc 2>/dev/null
    fi
    
    [ -f "/usr/bin/qemu-$arch-static" ] && cp "/usr/bin/qemu-$arch-static" "$rootfs/usr/bin/"
fi

trap cleanup EXIT
trap cleanup ERR

rm -f $rootfs/etc/resolv.conf
touch $rootfs/etc/resolv.conf
cp -Lar "$rootfs/." "$auroraboot/"
if grep -q "nameserver" /etc/resolv.conf; then
  mount --bind /etc/resolv.conf $auroraboot/etc/resolv.conf
  mount --bind /etc/resolv.conf $rootfs/etc/resolv.conf
else
  echo "nameserver 8.8.8.8" > $auroraboot/etc/resolv.conf
  echo "nameserver 8.8.8.8" > $rootfs/etc/resolv.conf
fi
cp -r auroraboot/. "$auroraboot/"
cp -r patches/shimboot/. "$auroraboot/"
echo_c "Done. Rootfs: $(du -sh $rootfs | awk '{print $1}')\n\n${BLUE_B}Installing Bootloader Packages" GEEN_B
chroot "$auroraboot" /bin/sh -c "export PATH=/sbin:/bin:/usr/sbin:/usr/bin && chmod +x /opt/setup_auroraboot.sh && /opt/setup_auroraboot.sh $arch"
rm -f $auroraboot/opt/setup_auroraboot.sh
echo_c "Done. Auroraboot: $(du -sh $auroraboot | awk '{print $1}')\n\n${BLUE_B}Installing Rootfs Packages" GEEN_B
cp -r rootfs/. "$rootfs/"
mkdir -p "$rootfs/usr/share/patches/sh1mmer"
cp -r patches/sh1mmer/. "$rootfs/usr/share/patches/sh1mmer/"
chroot "$rootfs" /bin/sh -c "export PATH=/sbin:/bin:/usr/sbin:/usr/bin && chmod +x /opt/setup_rootfs.sh && /opt/setup_rootfs.sh $arch"
$krill && sed -i 's/shrimp=0/shrimp=1/' $rootfs/etc/aurora
sed -i "s/origin=alpine/origin=$(git branch --show-current)/" $rootfs/etc/aurora
rm -f $rootfs/opt/setup_rootfs.sh
echo_c "Done. Rootfs: $(du -sh $rootfs | awk '{print $1}')\n\n${BLUE_B}Downloading firmware..." GEEN_B
[ ! -d linux-firmware ] && git clone --depth=1 https://chromium.googlesource.com/chromiumos/third_party/linux-firmware
cp -r linux-firmware/* $rootfs/lib/firmware/
find "$rootfs/lib/firmware" -type f -not \( -path "*wifi*" -o -path "*rt*" -o -path "*ath*" -o -path "*mediatek*" \) -exec rm -rf {} + >/dev/null 2>&1
touch "$rootfs/lib/firmware/.exists"
tar -C "$(dirname "$rootfs/lib/firmware")" -cf - "$(basename "$rootfs/lib/firmware")" | sh -c "zstd -T0 -19 > '$rootfs/root/firmware.tar.zst'"
rm -rf "$rootfs/lib/firmware"
mkdir -p "$rootfs/lib/firmware"
cp "./lib/$arch/frecon-lite" $rootfs/usr/bin/frecon-lite

echo_c "Done. Rootfs: $(du -sh $rootfs | awk '{print $1}')\n\n${BLUE_B}Building shim..." GEEN_B

mkdir -p "$auroraboot"

shimdev=$(losetup -Pf --show "$shim")
dev=$(losetup -Pf --show "$aurorashim")
copyfromcros() {
  for path in $@; do
    cp -a ${tempmount}${path} $rootfs/.crosenv/usr/bin/
  done
}

chromeos=$(cgpt find -l ROOT-A "$shimdev" | head -n 1)
tempmount=$(mktemp -d)
echo_c "Done. Rootfs: $(du -sh $rootfs | awk '{print $1}')\n\n${BLUE_B}Copying Modules..." GEEN_B
mount -o ro "$chromeos" "$tempmount"
if [ -d "$tempmount/lib/modules" ]; then
  cp -ar "$tempmount/lib/modules" $rootfs/lib/
  cp -ar "$tempmount/etc/lsb-release" $rootfs/etc/lsb-release
  boardname=$(lsbval CHROMEOS_RELEASE_BOARD)
  mkdir -p $rootfs/.crosenv/usr/bin $rootfs/.crosenv/lib64
  cp "$tempmount/usr/lib64/libpcre2-8.so*" $rootfs/.crosenv/lib64 2>/dev/null || :
  cp "$tempmount/usr/lib64/libreadline.so"* $rootfs/.crosenv/lib64 2>/dev/null || :
  cp -r "$tempmount/lib64"/* $rootfs/.crosenv/lib64 2>/dev/null || :
  copyfromcros /usr/bin/tpmc /bin/bash || :
  cp "./lib/$arch/busybox" $rootfs/.crosenv/usr/bin/busybox || :
  chmod +x $rootfs/.crosenv/usr/bin/*
  umount "$tempmount"
else
  echo_c "Please run on a raw shim." RED_B
  exit
fi

rm -f $rootfs/usr/bin/qemu-$arch-static
rm -f $auroraboot/usr/bin/qemu-$arch-static

echo_c "Done. Rootfs: $(du -sh $rootfs | awk '{print $1}')\n\n${BLUE_B}Copying Recovery Images, Shims, and Payloads..." GEEN_B
for shim in $shims; do
  mkdir -p $rootfs/usr/share/aurora/images/shims/
  [ -e "$shim" ] && cp $shim $rootfs/usr/share/aurora/images/shims/
done
for reco in $recovery; do
  mkdir -p $rootfs/usr/share/aurora/images/recovery/
  [ -e "$reco" ] && cp $reco $rootfs/usr/share/aurora/images/recovery/
done
for payload in $payloads; do
  mkdir -p $rootfs/usr/share/aurora/payloads
  [ -e "$payload" ] && cp $payload $rootfs/usr/share/aurora/payloads/
done
rm -f "$rootfs/sbin/init"
cp -ar rootfs/. "$rootfs"
echo_c "Done. Rootfs: $(du -sh $rootfs | awk '{print $1}')\n\n${BLUE_B}Partitioning shim..." "GEEN_B"
sgdisk --zap-all "$dev"
sgdisk -n 1:2048:10239 -c 1:"STATE" "$dev"
sgdisk -n 2:10240:75775 "$dev"
sgdisk -n 3:75776:117999 -c 3:"AuroraBoot" "$dev"
sgdisk -n 4:118000:0 -c 4:"Aurora" "$dev"
sgdisk -t 3:3CB8E202-3B7E-47DD-8A3C-7FF2A13CFCEC "$dev"
sgdisk -t 4:8300 "$dev"
sgdisk -p "$dev"

kernelpartition="${dev}p2"
skpart=$(cgpt find -l KERN-A "$shimdev" | head -n 1)
skpartnum="${skpart##*p}"
sgdisk -i "$skpartnum" "$shimdev"
dd if="$skpart" of="$kernelpartition" status=none

sgdisk --partition-guid=2:B5BAF579-07EF-A747-858B-87C0E507CD29 "$dev"
cgpt add -i 2 -t "$(cgpt show -i "$skpartnum" -t "$shimdev")" -l "$(cgpt show -i "$skpartnum" -l "$shimdev")" -P 15 -T 15 -S 1 "$dev" >/dev/null

state="${dev}p1"
root_a="${dev}p3"
root_b="${dev}p4"

mkfs.ext4 -F "$state" -L "STATE" >/dev/null 2>&1
mkfs.ext4 -F "$root_a" -L "AuroraBoot" >/dev/null 2>&1
mkfs.ext4 -F "$root_b" -L "Aurora" >/dev/null 2>&1

statemount=$(mktemp -d)
root_amount=$(mktemp -d)
root_bmount=$(mktemp -d)

mount "$state" "$statemount"
mkdir -p "$statemount/dev_image/etc/"
touch "$statemount/dev_image/etc/lsb-factory"

mount "$root_a" "$root_amount"
mount "$root_b" "$root_bmount"

echo_c "Done. Rootfs: $(du -sh $rootfs | awk '{print $1}')\n\n${BLUE_B}Copying rootfs to shim" "GEEN_B"
rm -f "$auroraboot/bin/init"
cp -ar auroraboot/. "$auroraboot"
avail_kb3=$(( $(df --output=avail --block-size=1 "$root_amount" | tail -n1 | tr -d ' ')/512 ))
need_kb3=$(( $(du -s --block-size=1 "$auroraboot" | awk '{print $1}')/512 ))
if [ -n "$avail_kb3" ] && [ "$avail_kb3" -lt $((need_kb3)) ]; then
  echo_c "Not enough space on target partition for auroraboot. Need $((need_kb3-avail_kb3)) additional sectors." RED_B
  echo_c "$(du -sh "$auroraboot" | awk '{print $1}')" GEEN_B
  df -h "$root_amount"
  exit 1
fi
if $verbose; then
  rsync -avH --info=progress2 --delete "$auroraboot/." "$root_amount" 2>&1 | tee /tmp/rsync-boot.log || { echo "rsync failed; see /tmp/rsync-boot.log"; tail -n 200 /tmp/rsync-boot.log; du -sh "$auroraboot"; lsblk; exit 1; }
  sleep 10
else
  rsync -avH --info=progress2 --delete "$auroraboot/." "$root_amount" 2>/tmp/rsync-boot.log || { echo "rsync failed; see /tmp/rsync-boot.log"; tail -n 200 /tmp/rsync-boot.log; exit 1; }
fi
avail_kb4=$(( $(df --output=avail --block-size=1 "$root_bmount" | tail -n1 | tr -d ' ')/512 ))
need_kb4=$(( $(du -s --block-size=1 "$rootfs" | awk '{print $1}')/512 ))
if [ -n "$avail_kb4" ] && [ "$avail_kb4" -lt $((need_kb4)) ]; then
  echo_c "Not enough space on target partition for rootfs. Need $((need_kb4-avail_kb4)) additional sectors." RED_B
  df -h "$root_bmount"
  exit 1
fi
if $verbose; then
  rsync -avH --info=progress2 --delete "$rootfs/." "$root_bmount" 2>&1 | tee /tmp/rsync-root.log || { echo "rsync failed; see /tmp/rsync-root.log"; tail -n 200 /tmp/rsync-root.log; du -sh "$rootfs"; lsblk; exit 1; }
  sleep 10
else
  rsync -avH --info=progress2 --delete "$rootfs/." "$root_bmount" 2>/tmp/rsync-root.log || { echo "rsync failed; see /tmp/rsync-root.log"; tail -n 200 /tmp/rsync-root.log; exit 1; }
fi
chmod +x "$root_amount/init" "$root_amount/sbin/init" "$root_amount/bootstrap.sh" 2>/dev/null || :
chmod +x "$root_bmount/sbin/init" "$root_bmount/usr/bin/"* "$root_bmount/usr/share/aurora/"* 2>/dev/null || :
sync

echo_c "Done. auroraboot: $(du -sh $auroraboot | awk '{print $1}')\n\n${BLUE_B}Cleaning up...\n" "GEEN_B"

trap - EXIT
trap - ERR

umount $auroraboot/etc/resolv.conf -l 2>/dev/null
umount $rootfs/etc/resolv.conf -l 2>/dev/null
umount "$statemount" "$root_amount" "$root_bmount"
umount "$statemount" -l 2>/dev/null
umount "$root_amount" -l 2>/dev/null
umount "$root_bmount" -l 2>/dev/null

squash_partitions $dev
sync
losetup -D
rm -rf "$rootfs" "$auroraboot" "$statemount" "$root_amount" "$root_bmount"
finalshim="${boardname}-aurora.bin"
sync
sleep 1
truncate_image $aurorashim
mv "$aurorashim" "$finalshim" 2>/dev/null

echo -e "${MAGENTA_B}Credits"
echo -e "${PINK_B}Sophia${COLOR_RESET}: Lead developer of Aurora, Got Wifi"
echo -e "${RED_B}Mariah Carey${COLOR_RESET}: Bugfixing and bugtesting, mostly the latter"
echo -e "${YELLOW_B}xmb9${COLOR_RESET}: ${GEEN_B}[PRIISM]${COLOR_RESET} Made Priism, Giving Aurora the ability to Boot Shims & Use Reco Images"
echo -e "${YELLOW_B}Synaptic${COLOR_RESET}: Emotional Support"
echo -e "${CYAN_B}Simon${COLOR_RESET}: ${BLUE_B}[IRS]${COLOR_RESET} Brainstormed how to do wifi, helped with dhcpcd"
echo -e "${BLUE_B}kraeb${COLOR_RESET}: ${BLUE_B}[IRS]${COLOR_RESET} QoL improvements and initial idea"
echo -e "${MAGENTA_B}AC3${COLOR_RESET}: Literally nothing"
echo_c "Done!" GEEN_B