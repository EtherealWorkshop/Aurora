#This is the automated buildscript for Aurora

export DEBUG="${DEBUG:=0}"
export COLOR_RESET="\033[0m"
export BLACK_B="\033[1;30m"
export RED_B="\033[1;31m"
export GEEN="\033[0;32m"
export GEEN_B="\033[1;32m"
export YELLOW="\033[0;33m"
export YELLOW_B="\033[1;33m"
export BLUE_B="\033[1;34m"
export MAGENTA_B="\033[1;35m"
export PINK_B="\x1b[1;38;2;235;170;238m"
export CYAN_B="\033[1;36m"

echo_c() {
    local text="$1"
    local color_variable="$2"
    local color="${!color_variable}"
    echo -e "${color}${text}${COLOR_RESET}"
}
cleanup() {
    for dir in proc sys dev run; do umount -l "$rootfs/$dir"; done
    rm -rf "$rootfs" "$auroraboot" "$statemount" "$root_amount" "$root_bmount"
}
lsbval() {
  local key="$1" lsbfile="${2:-$rootfs/etc/lsb-release}"
  echo "$key" | grep -Eq '^[a-zA-Z0-9_]+$' || return 1
  sed -E -n -e "/^[[:space:]]*${key}[[:space:]]*=/{
    s:^[^=]+=[[:space:]]*::
    s:[[:space:]]+$::
    p
  }" "$lsbfile"
}
source ./checks $@

if [ -z "$shim" ] || echo "$shim" | grep -vq ".bin"; then
  echo_c "Please run on a raw shim." RED_B
fi

auroraboot=$(mktemp -d)
rootfs=$(mktemp -d)
rm -rf "$rootfs" "$auroraboot"
mkdir -p "$rootfs" "$auroraboot"
[ -z "rootfs/usr/share/aurora/aurora.sh" ] && echo_c "Please run in the base directory of Aurora." RED_B

if findmnt -T "$rootfs" -o OPTIONS -n | grep -qE 'noexec|nodev'; then
    mount -o remount,dev,exec "$(findmnt -T "$rootfs" -o TARGET -n)"
fi
rm -f "$aurorashim"

truncate -s 694200K "$aurorashim" # haha 69

echo_c "\nBootstrapping Alpine" BLUE_B
wget -q --show-progress "https://dl-cdn.alpinelinux.org/alpine/v3.22/releases/$arch/alpine-minirootfs-3.22.0-$arch.tar.gz" -O alpine-minirootfs.tar.gz 

tar -xf alpine-minirootfs.tar.gz -C "$rootfs"
rm -f "$rootfs/sbin/init" "alpine-minirootfs.tar.gz"

echo "nameserver 1.1.1.1" > "$rootfs/etc/resolv.conf"

if [ "$hostarch" != "$arch" ]; then
    echo_c "Done. Rootfs: $(du -sh $rootfs | awk '{print $1}')\n\n${BLUE_B}Setting up QEMU " GEEN_B
    sudo mount -t binfmt_misc none /proc/sys/fs/binfmt_misc 2>/dev/null
    if ! grep -q binfmt_misc /proc/filesystems; then
       sudo modprobe binfmt_misc 2>/dev/null
    fi
    
    [ -f "/usr/bin/qemu-$arch-static" ] && cp "/usr/bin/qemu-$arch-static" "$rootfs/usr/bin/"
fi

trap cleanup EXIT

cp -Lar "$rootfs/." "$auroraboot/"
cp -r auroraboot/. "$auroraboot/"
cp -r patches/shimboot/. "$auroraboot/"
echo_c "Done. Rootfs: $(du -sh $rootfs | awk '{print $1}')\n\n${BLUE_B}Installing Bootloader Packages" GEEN_B
chroot "$auroraboot" /bin/sh -c "export PATH=/sbin:/bin:/usr/sbin:/usr/bin && chmod +x /opt/setup_auroraboot.sh && /opt/setup_auroraboot.sh $arch"
echo_c "Done. Auroraboot: $(du -sh $auroraboot | awk '{print $1}')\n\n${BLUE_B}Installing Rootfs Packages" GEEN_B
cp -r rootfs/. "$rootfs/"
mkdir -p "$rootfs/usr/share/patches/sh1mmer"
cp -r patches/sh1mmer/. "$rootfs/usr/share/patches/sh1mmer/"
chroot "$rootfs" /bin/sh -c "export PATH=/sbin:/bin:/usr/sbin:/usr/bin && chmod +x /opt/setup_rootfs.sh && /opt/setup_rootfs.sh $arch"
echo_c "Done. Rootfs: $(du -sh $rootfs | awk '{print $1}')\n\n${BLUE_B}Downloading firmware..." GEEN_B
git clone --depth=1 https://chromium.googlesource.com/chromiumos/third_party/linux-firmware $rootfs/lib/firmware/
find "$rootfs/lib/firmware" -type f -not \( -path "*wifi*" -o -path "*rt*" -o -path "*ath*" -o -path "*mediatek*" \) -exec rm -rf {} + >/dev/null 2>&1

trap - EXIT
echo_c "Done. Rootfs: $(du -sh $rootfs | awk '{print $1}')\n\n${BLUE_B}Building shim..." GEEN_B

mkdir -p "$auroraboot"

shimdev=$(losetup -Pf --show "$shim")
dev=$(losetup -Pf --show "$aurorashim")
copyfromcros() {
  for path in $@; do
    cp -a ${tempmount}${path} $rootfs/.crosenv/usr/bin/
  done
}
chromeos=$(cgpt find -l ROOT-A "$shimdev" | head -n 1)
tempmount=$(mktemp -d)
echo_c "Done. Rootfs: $(du -sh $rootfs | awk '{print $1}')\n\n${BLUE_B}Copying Modules..." GEEN_B
mount -o ro "$chromeos" "$tempmount"
if [ -d "$tempmount/lib/modules" ]; then
  cp -ar "$tempmount/lib/modules" $rootfs/lib/
  cp -ar "$tempmount/etc/lsb-release" $rootfs/etc/lsb-release
  export boardname=$(lsbval CHROMEOS_RELEASE_BOARD)
  
  mkdir -p $rootfs/.crosenv/usr/bin $rootfs/.crosenv/lib64
  cp "$tempmount/usr/lib64/libreadline.so"* $rootfs/.crosenv/lib64 2>/dev/null
  cp -r "$tempmount/lib64"/* $rootfs/.crosenv/lib64 2>/dev/null
  copyfromcros /usr/bin/tpmc /bin/bash /bin/cat /bin/mount /bin/ls /usr/bin/coreutils /usr/bin/pkill /bin/rm /bin/sleep
  cp "./lib/noarch/kvg" $rootfs/.crosenv/usr/bin/kvg
  cp "./lib/$arch/frecon-lite" $rootfs/.crosenv/usr/bin/frecon-lite
  chmod +x $rootfs/.crosenv/usr/bin/*
  umount "$tempmount"
else
  echo_c "Please run on a raw shim." RED_B
  exit
fi

rm -f $rootfs/usr/bin/qemu-$arch-static
rm -f $auroraboot/usr/bin/qemu-$arch-static

echo_c "Done. Rootfs: $(du -sh $rootfs | awk '{print $1}')\n\n${BLUE_B}Partitioning shim..." GEEN_B
sgdisk --zap-all "$dev"
sgdisk -n 1:2048:10239 -c 1:"STATE" "$dev"
sgdisk -n 2:10240:75775 "$dev"
sgdisk -n 3:75776:178175 -c 3:"AuroraBoot" "$dev"
sgdisk -n 4:178176:0 -c 4:"Aurora" "$dev"
sgdisk -t 3:3CB8E202-3B7E-47DD-8A3C-7FF2A13CFCEC "$dev"
sgdisk -t 4:8300 "$dev"
sgdisk -p "$dev"

kernelpartition="${dev}p2"
skpart=$(cgpt find -l KERN-A "$shimdev" | head -n 1)
skpartnum="${skpart##*p}"
sgdisk -i "$skpartnum" "$shimdev"
dd if="$skpart" of="$kernelpartition" status=none

sgdisk --partition-guid=2:B5BAF579-07EF-A747-858B-87C0E507CD29 "$dev"
cgpt add -i 2 -t "$(cgpt show -i "$skpartnum" -t "$shimdev")" -l "$(cgpt show -i "$skpartnum" -l "$shimdev")" -P 15 -T 15 -S 1 "$dev" >/dev/null

state="${dev}p1"
root_a="${dev}p3"
root_b="${dev}p4"

mkfs.ext4 -F "$state" -L "STATE" >/dev/null 2>&1
mkfs.ext4 -F "$root_a" -L "AuroraBoot" >/dev/null 2>&1
mkfs.ext4 -F "$root_b" -L "Aurora" >/dev/null 2>&1

statemount=$(mktemp -d)
root_amount=$(mktemp -d)
root_bmount=$(mktemp -d)

mount "$state" "$statemount"
mkdir -p "$statemount/dev_image/etc/"
touch "$statemount/dev_image/etc/lsb-factory"

mount "$root_a" "$root_amount"
mount "$root_b" "$root_bmount"

echo_c "Done. Rootfs: $(du -sh $rootfs | awk '{print $1}')\n\n${BLUE_B}Copying rootfs to shim" "GEEN_B"
rm -f "$rootfs/sbin/init"
cp -ar rootfs/. "$rootfs"
if [ "$DEBUG" -eq "1" ]; then
    rsync -avH --info=progress2 --delete "$rootfs/." "$root_bmount" || { echo "failed to copy all files"; exit 1; }
    sleep 10
else
    rsync -avH --info=progress2 --delete "$rootfs/." "$root_bmount" >/dev/null || { echo "failed to copy all files"; exit 1; }
fi
echo_c "Done. Rootfs: $(du -sh $rootfs | awk '{print $1}')\n\n${BLUE_B}Copying auroraboot to shim" "GEEN_B"
rm -f "$auroraboot/bin/init"
cp -ar auroraboot/. "$auroraboot"
if [ "$DEBUG" -eq "1" ]; then
    rsync -avH --info=progress2 --delete "$auroraboot/." "$root_amount" || { echo "failed to copy all files"; exit 1; }
    sleep 10
else
    rsync -avH --info=progress2 --delete "$auroraboot/." "$root_amount" >/dev/null || { echo "failed to copy all files"; exit 1; }
fi
chmod +x "$root_amount/init" "$root_amount/sbin/init" "$root_amount/bootstrap.sh" 2>/dev/null
chmod +x "$root_bmount/sbin/init" "$root_bmount/usr/bin/"* "$root_bmount/usr/share/aurora/"* 2>/dev/null
sync

echo_c "Done. auroraboot: $(du -sh $auroraboot | awk '{print $1}')\n\n${BLUE_B}Cleaning up...\n" "GEEN_B"
umount "$statemount" "$root_amount" "$root_bmount"
umount "$statemount" -l 2>/dev/null
umount "$root_amount" -l 2>/dev/null
umount "$root_bmount" -l 2>/dev/null

losetup -D
rm -rf "$rootfs" "$auroraboot" "$statemount" "$root_amount" "$root_bmount"
mv "$aurorashim" "${boardname}-aurora.bin" 2>/dev/null
finalshim="${boardname}-aurora.bin"

echo -e "${MAGENTA_B}Credits"
echo -e "${PINK_B}Sophia${COLOR_RESET}: Lead developer of Aurora, Got Wifi"
echo -e "${RED_B}Mariah Carey${COLOR_RESET}: Bugfixing and bugtesting, mostly the latter"
echo -e "${YELLOW_B}xmb9${COLOR_RESET}: ${GEEN_B}[PRIISM]${COLOR_RESET} Made Priism, Giving Aurora the ability to Boot Shims & Use Reco Images"
echo -e "${YELLOW_B}Synaptic${COLOR_RESET}: Emotional Support"
echo -e "${CYAN_B}Simon${COLOR_RESET}: ${BLUE_B}[IRS]${COLOR_RESET} Brainstormed how to do wifi, helped with dhcpcd"
echo -e "${BLUE_B}kraeb${COLOR_RESET}: ${BLUE_B}[IRS]${COLOR_RESET} QoL improvements and initial idea"
echo -e "${MAGENTA_B}AC3${COLOR_RESET}: Literally nothing"
echo_c "Done!" GEEN_B
